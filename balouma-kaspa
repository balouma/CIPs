// SPDX-License-Identifier: MIT
pragma solidity ^0.8.0;

contract KaspaMerkleRootVerifier {
    // Mapping block => Merkle Root
    mapping(uint256 => bytes32) public kaspaMerkleRoots;

    // Submit the Merkle root for a batch of Kaspa headers
    function submitKaspaMerkleRoot(uint256 canxiumBlockNumber, bytes32 merkleRoot) external {
        require(kaspaMerkleRoots[canxiumBlockNumber] == bytes32(0), "Root already submitted");
        kaspaMerkleRoots[canxiumBlockNumber] = merkleRoot;
    }

    // Verify a Kaspa block hash is part of the Merkle tree
    function verifyKaspaBlockHash(
        uint256 canxiumBlockNumber,
        bytes32[] memory proof,
        uint256 index,
        bytes32 leafHash
    ) public view returns (bool) {
        bytes32 hash = leafHash;
        for (uint256 i = 0; i < proof.length; i++) {
            if (index % 2 == 0) {
                hash = keccak256(abi.encodePacked(hash, proof[i]));
            } else {
                hash = keccak256(abi.encodePacked(proof[i], hash));
            }
            index /= 2;
        }
        return hash == kaspaMerkleRoots[canxiumBlockNumber];
    }
}


